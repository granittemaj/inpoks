{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "inpo/news-grid",
	"title": "News cards",
	"category": "inpo",
	"icon": "excerpt-view",
	"description": "News cards with search, category, programme, year and order filters. Uses the page query.",
	"textdomain": "inpo-core",
	"attributes": {
		"placeholder": {
			"type": "string",
			"default": "Kërko, p.sh. OShP, stadiume, Vushtrri"
		},
		"allLabel": {
			"type": "string",
			"default": "Të gjitha"
		},
		"programLabel": {
			"type": "string",
			"default": "Programi"
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true
	},
	"editorScript": "inpo-core-editor",
	"viewScript": "inpo-core-view"
}
