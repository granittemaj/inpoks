{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "inpo/projects",
	"title": "Projects (home)",
	"category": "inpo",
	"icon": "portfolio",
	"description": "Active projects first, then the latest completed ones, with donors and partners below.",
	"textdomain": "inpo-core",
	"attributes": {
		"kicker": {
			"type": "string",
			"default": "Projektet dhe partnerët"
		},
		"heading": {
			"type": "string",
			"default": "Projektet tona"
		},
		"count": {
			"type": "number",
			"default": 3
		},
		"linkText": {
			"type": "string",
			"default": "Të gjitha projektet"
		},
		"showDonors": {
			"type": "boolean",
			"default": true
		},
		"donorsHeading": {
			"type": "string",
			"default": "Donatorët dhe partnerët"
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true
	},
	"editorScript": "inpo-core-editor"
}
