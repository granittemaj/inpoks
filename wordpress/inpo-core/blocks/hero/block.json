{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "inpo/hero",
	"title": "Hero",
	"category": "inpo",
	"icon": "megaphone",
	"description": "Large home page headline with two buttons, a photo and the fields of action.",
	"textdomain": "inpo-core",
	"attributes": {
		"line1": {
			"type": "string",
			"default": "Llogaridhënie,"
		},
		"line2": {
			"type": "string",
			"default": "jo premtime."
		},
		"lead": {
			"type": "string",
			"default": "Monitorojmë prokurimin publik dhe vendimet e institucioneve në Kosovë, publikojmë çfarë gjejmë dhe kërkojmë që paraja publike të shpenzohet me ligj."
		},
		"cta1Text": {
			"type": "string",
			"default": "Shfleto publikimet"
		},
		"cta1Url": {
			"type": "string",
			"default": ""
		},
		"cta2Text": {
			"type": "string",
			"default": "Rreth INPO-s"
		},
		"cta2Url": {
			"type": "string",
			"default": ""
		},
		"areasLabel": {
			"type": "string",
			"default": "Fushat e veprimit"
		},
		"areas": {
			"type": "string",
			"default": ""
		},
		"image": {
			"type": "string",
			"default": ""
		},
		"imageCaption": {
			"type": "string",
			"default": "Prezantimi i raportit “Integriteti i kandidatëve, sundimi i ligjit dhe qeverisja e mirë”, shkurt 2025"
		},
		"showImage": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true
	},
	"editorScript": "inpo-core-editor"
}
