{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "inpo/team",
	"title": "Team",
	"category": "inpo",
	"icon": "groups",
	"description": "Team and board with photo, role and email (INPO > Team).",
	"textdomain": "inpo-core",
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"teamLabel": {
			"type": "string",
			"default": "Ekipi"
		},
		"boardLabel": {
			"type": "string",
			"default": "Bordi"
		},
		"wrapped": {
			"type": "boolean",
			"default": true
		},
		"anchor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true
	},
	"editorScript": "inpo-core-editor"
}
