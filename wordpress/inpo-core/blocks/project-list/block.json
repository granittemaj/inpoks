{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "inpo/project-list",
	"title": "Project list",
	"category": "inpo",
	"icon": "list-view",
	"description": "Projects with active and completed filters. Uses the projects archive.",
	"textdomain": "inpo-core",
	"attributes": {
		"allLabel": {
			"type": "string",
			"default": "Të gjitha"
		},
		"activeLabel": {
			"type": "string",
			"default": "Projektet aktive"
		},
		"doneLabel": {
			"type": "string",
			"default": "Projektet e përfunduara"
		},
		"links": {
			"type": "string",
			"default": "ndikimi|Rezultatet dhe ndikimi institucional\npartneret|Partnerët dhe donatorët"
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true
	},
	"editorScript": "inpo-core-editor"
}
