{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "inpo/donors",
	"title": "Donors",
	"category": "inpo",
	"icon": "heart",
	"description": "Donor and partner logos with the grant note.",
	"textdomain": "inpo-core",
	"attributes": {
		"kicker": {
			"type": "string",
			"default": "Donatorët dhe partnerët"
		},
		"showFineprint": {
			"type": "boolean",
			"default": true
		},
		"anchor": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true
	},
	"editorScript": "inpo-core-editor"
}
